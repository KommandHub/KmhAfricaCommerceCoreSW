{
    "name": "kommandhub/africa-commerce-core-sw",
    "description": "Localization, geography and address foundation for African markets: ISO reference data, administrative divisions, extra address fields and phone normalization for Shopware 6.",
    "type": "shopware-platform-plugin",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "keywords": [
        "shopware",
        "shopware6",
        "shopware-plugin",
        "africacommercecore",
        "cli",
        "custom-fields",
        "storefront"
    ],
    "homepage": "https://github.com/Kommandhub/KmhAfricaCommerceCoreSW",
    "authors": [
        {
            "name": "Kommandhub",
            "email": "info@kommandhub.com",
            "homepage": "https://kommandhub.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "info@kommandhub.com",
        "issues": "https://github.com/Kommandhub/KmhAfricaCommerceCoreSW/issues",
        "source": "https://github.com/Kommandhub/KmhAfricaCommerceCoreSW",
        "docs": "https://github.com/Kommandhub/KmhAfricaCommerceCoreSW/blob/main/README.md"
    },
    "require": {
        "php": ">=8.2",
        "ext-intl": "*",
        "giggsey/libphonenumber-for-php": "^8.13",
        "shopware/core": "~6.6.0 || ~6.7.0",
        "shopware/storefront": "~6.6.0 || ~6.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "shopware/dev-tools": "^1.5",
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "autoload": {
        "psr-4": {
            "Kommandhub\\AfricaCommerceCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kommandhub\\AfricaCommerceCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "shopware-plugin-class": "Kommandhub\\AfricaCommerceCore\\KmhAfricaCommerceCoreSW",
        "label": {
            "de-DE": "African Commerce Core",
            "en-GB": "African Commerce Core",
            "fr-FR": "African Commerce Core"
        },
        "description": {
            "de-DE": "Lokalisierungs-, Geo- und Adressbasis für afrikanische Märkte: ISO-Referenzdaten, Verwaltungsbezirke, zusätzliche Adressfelder und Telefonnummern-Normalisierung für Shopware 6.",
            "en-GB": "Localization, geography and address foundation for African markets: ISO reference data, administrative divisions, extra address fields and phone normalization for Shopware 6.",
            "fr-FR": "Base de localisation, géographie et adresses pour les marchés africains : données ISO, divisions administratives, champs d'adresse et normalisation des numéros pour Shopware 6."
        },
        "manufacturerLink": {
            "de-DE": "https://kommandhub.com",
            "en-GB": "https://kommandhub.com"
        },
        "supportLink": {
            "de-DE": "https://kommandhub.com/support",
            "en-GB": "https://kommandhub.com/support"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
